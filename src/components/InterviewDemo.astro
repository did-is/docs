  .interview-demo [hidden]{display:none!important}.interview-demo :is(p,h2,h3,figure,ol){margin:0}.interview-demo button{font:inherit;cursor:pointer;min-width:0;color:inherit;line-height:1.4}.interview-demo :is(button,summary,a):focus-visible{outline:2px solid var(--sl-color-text-accent);outline-offset:3px}.interview-demo :is(p,small,strong,code,dd,pre){overflow-wrap:anywhere}
  .tour-heading{padding:1.5rem 1.5rem 1.2rem}.tour-eyebrow{font-size:.72rem;letter-spacing:.04em;color:var(--sl-color-gray-2);font-weight:600}.tour-heading>p{font-size:clamp(1.3rem,3vw,1.65rem);font-weight:600;line-height:1.3;margin:.4rem 0 .6rem}.tour-intro{display:block;color:var(--sl-color-gray-2);font-size:.9rem;line-height:1.6;max-width:42rem}
  .chapter-navigation{padding:0 1.5rem 1.25rem}.chapter-navigation ol{list-style:none;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem}.chapter-navigation li{margin:0;min-width:0}.chapter-navigation button{border:1px solid var(--sl-color-gray-4);background:var(--surface);border-radius:.7rem;display:flex;align-items:flex-start;text-align:left;gap:.55rem;width:100%;height:100%;padding:.8rem .65rem}.chapter-navigation button[aria-current="step"]{background:var(--sl-color-accent-low);border-color:var(--sl-color-text-accent);box-shadow:inset 0 0 0 1px var(--sl-color-text-accent)}.chapter-navigation strong{display:block;font-size:.81rem;font-weight:600}.chapter-navigation small{display:block;font-size:.71rem;color:var(--sl-color-gray-2);margin-top:.25rem;line-height:1.4}.chapter-number{flex:none;display:grid;place-items:center;width:1.3rem;height:1.3rem;background:var(--sl-color-gray-6);border-radius:50%;font-size:.72rem;font-weight:600}
  .chapter-panel{border-top:1px solid var(--hairline);padding:1.5rem;min-width:0}.chapter-heading h2{font-size:clamp(1.3rem,3vw,1.65rem);line-height:1.3;letter-spacing:-.02em;margin:.4rem 0 .65rem;padding:0}.chapter-heading h2:focus{outline:none}.chapter-heading>p{font-size:.9rem;line-height:1.65;color:var(--sl-color-gray-2);max-width:42rem}.lookup-context{border:1px solid var(--hairline);border-radius:.6rem;padding:.7rem .85rem;margin:1rem 0;font-size:.82rem}.lookup-context summary{font-weight:600;cursor:pointer}.lookup-context p{margin:.75rem 0 0;line-height:1.6}.lookup-path{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin-top:1rem}.fine-print{font-size:.76rem;color:var(--sl-color-gray-2)}
  .chapter-panel :global(.source-demo){border:0;padding:0;margin:1.2rem 0;border-radius:0;background:transparent}.chapter-panel :global(.demo-heading){display:none}.chapter-panel :global(.time-mode){border-top:0;padding-top:0}.chapter-panel :global(.time-mode label){font-size:.78rem;color:var(--sl-color-gray-2)}.chapter-panel :global(.time-mode select){font-size:.85rem}
  .chapter-takeaway{border-top:1px solid var(--hairline);padding-top:1rem;margin-top:1.25rem!important;font-size:.88rem;line-height:1.65}.chapter-takeaway>span{display:block;font-size:.7rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--sl-color-text-accent);margin-bottom:.3rem}.guide-link{display:inline-block;font-size:.8rem;margin-top:.8rem;text-underline-offset:3px}
  .evidence-map{margin:1.25rem 0!important;background:var(--surface);border:1px solid var(--hairline);border-radius:.7rem;padding:.65rem}.evidence-map svg{display:block;width:100%;height:auto}.evidence-map figcaption{font-size:.72rem;color:var(--sl-color-gray-2);line-height:1.55;padding:0 .4rem .3rem}.map-node rect{fill:var(--sl-color-gray-6);stroke:var(--sl-color-gray-4);stroke-width:1}.map-node text{fill:var(--sl-color-white);font-size:14px;font-weight:600;text-anchor:middle}.map-node .map-sub{font-size:11px;font-weight:400;fill:var(--sl-color-gray-2)}.map-links path{stroke:var(--sl-color-gray-4);stroke-width:2}.map-links path[data-selected="true"]{stroke:var(--sl-color-text-accent);stroke-width:4}#interview-arrow path{fill:var(--sl-color-gray-3)}.map-labels text{text-anchor:middle;font-size:12px;fill:var(--sl-color-gray-2)}
  .relation-choices{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem;margin:1rem 0}.relation-choices button,.delegation-choices button{border:1px solid var(--sl-color-gray-4);border-radius:.65rem;background:var(--surface);padding:.75rem;text-align:left;display:flex;flex-direction:column;align-items:flex-start;gap:.25rem;margin:0}.relation-choices button[aria-pressed="true"],.delegation-choices button[aria-pressed="true"]{border-color:var(--sl-color-text-accent);box-shadow:inset 0 0 0 1px var(--sl-color-text-accent);background:var(--sl-color-accent-low)}.relation-choices strong,.delegation-choices strong{font-size:.8rem;font-weight:600}.relation-choices button>span:not(.choice-index),.delegation-choices button>span{font-size:.73rem;color:var(--sl-color-gray-2)}.choice-index{font-size:.7rem;color:var(--sl-color-text-accent);font-weight:600}.relation-choices small{font-family:var(--sl-font-mono);font-size:.64rem;letter-spacing:.02em;margin-top:.35rem}
  .evidence-result{--result-accent:var(--neutral);border:1px solid var(--hairline);border-left:4px solid var(--result-accent);border-radius:.75rem;padding:1.1rem;background:var(--surface);margin:1rem 0}.evidence-result[data-tone="verified"],.evidence-result[data-tone="allowed"]{--result-accent:var(--ok)}.evidence-result[data-tone="denied"]{--result-accent:var(--bad)}.evidence-result[data-tone="observed"]{--result-accent:var(--info)}.evidence-result[data-tone="unknown"]{--result-accent:var(--warn)}.result-top{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:.5rem;margin-bottom:.75rem}.recorded-label{font-size:.67rem;font-weight:500;line-height:1.5;color:var(--sl-color-gray-2)}.result-state{color:var(--result-accent);font-size:.7rem;font-weight:600;line-height:1.4}.evidence-result h3{font-size:clamp(1.1rem,2.5vw,1.3rem);line-height:1.35;letter-spacing:-.015em;font-weight:600}.result-description{font-size:.87rem;line-height:1.7;margin:.65rem 0!important}.result-boundary{border-top:1px solid var(--hairline);padding-top:.8rem;margin-top:.9rem}.result-boundary>strong{font-size:.73rem;font-weight:600}.result-boundary p{font-size:.8rem;color:var(--sl-color-gray-2);line-height:1.6;margin-top:.25rem}.record-metadata,.request-summary{display:grid;grid-template-columns:1fr;gap:.65rem;margin:1rem 0 0}.record-metadata>div,.request-summary>div{min-width:0}.record-metadata dt,.request-summary dt{font-size:.68rem;color:var(--sl-color-gray-2)}.record-metadata dd,.request-summary dd{margin:.2rem 0 0;font-size:.72rem;line-height:1.5;font-family:var(--sl-font-mono)}
  .technical-record{margin:1rem 0;font-size:.8rem;min-width:0}.technical-record summary{cursor:pointer;font-weight:600;padding:.5rem 0}.technical-record p{margin:.6rem 0;line-height:1.65;color:var(--sl-color-gray-2)}.technical-record pre{font-size:.7rem;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere;background:var(--surface);border:1px solid var(--hairline);border-radius:.5rem;padding:.75rem;max-height:24rem;overflow:auto;max-width:100%;margin:.65rem 0}.technical-record pre.root-value{max-height:8rem}
  .delegation-map{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:.4rem;margin:1.25rem 0 .6rem;padding:1rem .7rem;border:1px solid var(--hairline);border-radius:.7rem;background:var(--surface)}.delegation-map>div{text-align:center;min-width:0}.actor-symbol{display:grid;width:1.9rem;height:1.9rem;place-items:center;margin:0 auto .5rem;background:var(--sl-color-accent-low);color:var(--sl-color-text-accent);border:1px solid var(--sl-color-gray-4);border-radius:50%;font-size:.8rem;font-weight:600}.delegation-map strong{display:block;font-size:.85rem;font-weight:600}.delegation-map small{display:block;font-size:.68rem;line-height:1.5;color:var(--sl-color-gray-2);margin-top:.25rem}.role-arrow{font-size:1.2rem;color:var(--sl-color-gray-3)}.map-caption{font-size:.74rem;line-height:1.6;color:var(--sl-color-gray-2);margin:.6rem 0 1rem!important}.delegation-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem;margin:1rem 0 .75rem}.changed-condition{font-size:.8rem;line-height:1.6;color:var(--sl-color-gray-2);min-height:2.6em}.request-summary{grid-template-columns:1fr 1fr}.request-summary>div:last-child{grid-column:1/-1}.delegation-checks{list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin-top:1rem!important}.delegation-checks li{border:1px solid var(--hairline);border-radius:.5rem;padding:.65rem;margin:0;min-width:0}.delegation-checks strong{display:block;font-size:.73rem;font-weight:600;margin-bottom:.3rem}.delegation-checks span{display:block;font-size:.72rem;line-height:1.5}.delegation-checks li[data-status="pass"] span{color:var(--ok)}.delegation-checks li[data-status="fail"] span{color:var(--bad)}.delegation-checks li[data-status="unknown"] span{color:var(--sl-color-gray-2)}.no-execution{font-size:.76rem;line-height:1.7;color:var(--sl-color-gray-2);margin:1rem 0!important}.no-execution strong{color:var(--sl-color-white)}
  .tour-footer{display:flex;justify-content:space-between;align-items:center;gap:.8rem;border-top:1px solid var(--hairline);padding:1rem 1.5rem}.tour-footer button{font-size:.76rem;font-weight:600;border:1px solid var(--sl-color-gray-4);border-radius:.5rem;padding:.6rem .7rem;background:var(--surface);text-align:left}.tour-footer button:disabled{opacity:.5;cursor:default}.tour-footer>span{font-size:.7rem;white-space:nowrap;color:var(--sl-color-gray-2)}
  @media(max-width:40rem){.tour-heading{padding:1.1rem 1rem 1rem}.chapter-navigation{padding:0 1rem 1rem}.chapter-navigation ol{grid-template-columns:1fr;gap:.4rem}.chapter-navigation button{align-items:center;padding:.65rem .7rem}.chapter-navigation button>span:last-child{display:flex;align-items:center;flex:1;justify-content:space-between;gap:.5rem}.chapter-navigation small{margin:0;text-align:right;font-size:.69rem}.chapter-panel{padding:1.1rem 1rem}.evidence-map svg{display:none}.evidence-map{padding:.75rem}.evidence-map figcaption{padding:0}.relation-choices{grid-template-columns:1fr;gap:.45rem}.relation-choices button{display:grid;grid-template-columns:1.1rem 1fr auto;align-items:center;gap:.2rem .4rem}.relation-choices button>span:not(.choice-index){grid-column:2/3}.relation-choices small{grid-column:3/4;grid-row:1/3;margin:0;font-size:.61rem}.choice-index{grid-row:1/3}.evidence-result{padding:.85rem}.delegation-map{padding:.8rem .5rem}.delegation-map small{font-size:.64rem}.delegation-map strong{font-size:.76rem}.delegation-choices{grid-template-columns:1fr}.delegation-choices button{padding:.65rem .75rem;gap:.25rem}.delegation-checks{grid-template-columns:1fr}.request-summary{grid-template-columns:1fr}.tour-footer{padding:.85rem 1rem;flex-wrap:wrap;gap:.6rem}.tour-footer>span{order:-1;flex:1 0 100%;text-align:center}.tour-footer button:last-child{margin-left:auto;max-width:65%}}
</style>

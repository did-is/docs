---
/** Responsive step flow (replaces ASCII box diagrams). Horizontal on wide screens, vertical on phones. */
interface Step {
  title: string;
  body?: string;
  code?: string;
}
interface Props {
  steps: Step[];
  label: string;
}
const { steps, label } = Astro.props;
---

<ol class="flow" aria-label={label}>
  {
    steps.map((s, i) => (
      <li class="flow-step">
        <span class="flow-index" aria-hidden="true">{i + 1}</span>
        <div class="flow-body">
          <strong class="flow-title">{s.title}</strong>
          {s.body && <span class="flow-text">{s.body}</span>}
          {s.code && <code class="flow-code">{s.code}</code>}
        </div>
      </li>
    ))
  }
</ol>
